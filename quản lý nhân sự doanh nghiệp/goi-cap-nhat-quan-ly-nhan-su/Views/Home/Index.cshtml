@model quản_lý_nhân_sự_doanh_nghiệp.Models.DashboardVM
@using quản_lý_nhân_sự_doanh_nghiệp.Models
@{ ViewBag.Title = "Tổng quan"; }

<h2>Tổng quan</h2>
<p class="phu">Số liệu theo phạm vi dữ liệu của tài khoản bạn.</p>

<div class="the-so">
    <div class="the"><b>@Model.TongNhanVien</b><span>Nhân viên</span></div>
    <div class="the"><b>@Model.MoiTrongThang</b><span>Vào làm trong tháng này</span></div>
    <div class="the"><b>@Model.SoChiNhanh</b><span>Chi nhánh</span></div>
    <div class="the"><b>@Model.SoPhongBan</b><span>Phòng ban</span></div>
    <div class="the @(Model.HopDongSapHet > 0 ? "canh-bao" : "")"><b>@Model.HopDongSapHet</b><span>Hợp đồng hết hạn trong 30 ngày</span></div>
</div>

<div class="luoi2">
    <section class="hop">
        <h3>Nhân viên theo phòng ban</h3>
        @if (Model.TheoPhongBan.Count == 0)
        {
            <p class="phu">Chưa có dữ liệu phân bổ nhân viên vào phòng ban.</p>
        }
        else
        {
            int max = Model.TheoPhongBan.Max(x => x.Value);
            foreach (var kv in Model.TheoPhongBan)
            {
                <div style="margin:8px 0">
                    <div style="display:flex;justify-content:space-between;font-size:14px"><span>@kv.Key</span><b>@kv.Value</b></div>
                    <div style="background:#eef1ec;border-radius:4px;height:8px"><div style="background:#1f6f54;height:8px;border-radius:4px;width:@((int)(100.0 * kv.Value / max))%"></div></div>
                </div>
            }
        }
    </section>

    <section class="hop">
        <h3>Hợp đồng sắp hết hạn</h3>
        @if (Model.DanhSachSapHet.Count == 0)
        {
            <p class="phu">Không có hợp đồng nào hết hạn trong 30 ngày tới.</p>
        }
        else
        {
            <table class="bang">
                <thead><tr><th>Nhân viên</th><th>Loại</th><th>Hết hạn</th></tr></thead>
                <tbody>
                @foreach (var h in Model.DanhSachSapHet)
                {
                    <tr>
                        <td>
                            @if (PhanQuyenHelper.CoQuyen("Employee.View"))
                            {
                                @Html.ActionLink(h.HoTen ?? ("Nhân viên #" + h.EmployeeId), "Details", "NhanSu", new { id = h.EmployeeId }, null)
                            }
                            else
                            {
                                @h.HoTen
                            }
                        </td>
                        <td>@h.Loai</td>
                        <td>@h.KetThuc.Value.ToString("dd/MM/yyyy") <span class="the-nho vang">còn @h.SoNgayCon ngày</span></td>
                    </tr>
                }
                </tbody>
            </table>
            if (PhanQuyenHelper.CoQuyen("Contract.View"))
            {
                <p style="margin:10px 0 0"><a href="@Url.Action("Index", "HopDong")">Xem tất cả hợp đồng</a></p>
            }
        }
    </section>
</div>
