@model List<quản_lý_nhân_sự_doanh_nghiệp.Models.HopDongRow>
@using quản_lý_nhân_sự_doanh_nghiệp.Models
@{
    ViewBag.Title = "Hợp đồng";
    string loc = (string)ViewBag.Loc;
    Func<string, string> lop = k => loc == k ? "btn btn-chinh" : "btn";
}

<h2>Hợp đồng lao động</h2>
<p class="phu">Theo dõi hợp đồng sắp hết hạn để gia hạn kịp thời.</p>

<div class="thanh-loc">
    <a class="@lop("sapHet")" href="@Url.Action("Index", new { loc = "sapHet" })">Sắp hết hạn (30 ngày)</a>
    <a class="@lop("daHet")" href="@Url.Action("Index", new { loc = "daHet" })">Đã hết hạn</a>
    <a class="@lop("khongThoiHan")" href="@Url.Action("Index", new { loc = "khongThoiHan" })">Không thời hạn</a>
    <a class="@lop("tatCa")" href="@Url.Action("Index", new { loc = "tatCa" })">Tất cả</a>
</div>

@if (Model.Count == 0)
{
    <div class="hop"><p class="phu" style="margin:0">Không có hợp đồng nào trong mục này.</p></div>
}
else
{
    <div class="cuon">
        <table class="bang">
            <thead><tr><th>Nhân viên</th><th>Loại hợp đồng</th><th>Bắt đầu</th><th>Kết thúc</th><th>Tình trạng</th></tr></thead>
            <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>
                        @if (PhanQuyenHelper.CoQuyen("Employee.View"))
                        {
                            @Html.ActionLink(h.HoTen ?? ("Nhân viên #" + h.EmployeeId), "Details", "NhanSu", new { id = h.EmployeeId }, null)
                        }
                        else
                        {
                            @h.HoTen
                        }
                    </td>
                    <td>@h.Loai</td>
                    <td>@h.BatDau.ToString("dd/MM/yyyy")</td>
                    <td>@(h.KetThuc.HasValue ? h.KetThuc.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>
                        @if (!h.KetThuc.HasValue) { <span class="the-nho xanh">Không thời hạn</span> }
                        else if (h.SoNgayCon < 0) { <span class="the-nho do">Hết hạn @(-h.SoNgayCon) ngày trước</span> }
                        else if (h.SoNgayCon <= 30) { <span class="the-nho vang">Còn @h.SoNgayCon ngày</span> }
                        else { <span class="the-nho xanh">Còn hiệu lực</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="phu" style="margin-top:8px">Hiện tối đa 300 dòng. Một nhân viên có thể có nhiều hợp đồng qua các thời kỳ.</p>
}
